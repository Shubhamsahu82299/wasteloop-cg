NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GEMINI_API_KEY=
CRON_SECRET=

# Use Neon's pooled connection string for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require&pgbouncer=true"

# Use Neon's direct (non-pooled) connection string for Prisma migrations.
# Private S3-compatible storage for complaint evidence.
# For AWS S3, set S3_REGION and leave S3_ENDPOINT empty.
# For Cloudflare R2, use S3_REGION=auto and your account's S3 API endpoint.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"
